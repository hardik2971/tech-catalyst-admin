# ── Tech Catalyst Summit Admin ──────────────────────────────
# Same MySQL database + SMTP as the website (copied from ../tech-catalyst-summit/.env)
NODE_ENV=development

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
DB_NAME=tech_catalyst_summit

SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=false
SMTP_EMAIL=info@techcatalystsummit.com
SMTP_PASSWORD=
SMTP_RECEIVER_EMAIL=info@techcatalystsummit.com

# Signs the admin session cookie (JWT). Keep secret.
ADMIN_JWT_SECRET=

# First super-admin, created automatically when the AdminUser table is empty.
# Change the password from Profile after the first login.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@techcatalystsummit.com
ADMIN_PASSWORD=

# Public website (used to preview /event, /speaker, /sponsor images stored as relative paths)
NEXT_PUBLIC_SITE_URL=http://localhost:2001

# Uploaded media is written into the website public folder so the site can serve it.
UPLOAD_DIR=../tech-catalyst-summit/public/uploads
UPLOAD_PUBLIC_PATH=/uploads
